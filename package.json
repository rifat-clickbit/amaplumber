{
  "name": "amaplumber",
  "version": "1.0.0",
  "private": true,
  "description": "AmaPlumber Plumbing & Gas static site",
  "scripts": {
    "build": "esbuild src/app.jsx --bundle --minify --format=iife --target=es2018 --jsx-factory=React.createElement --jsx-fragment=React.Fragment --outfile=dist/app.bundle.js",
    "start": "http-server . -p ${PORT:-3000} -c-1",
    "serve": "npx http-server -p 8080"
  },
  "dependencies": {
    "http-server": "14.1.1"
  },
  "devDependencies": {
    "esbuild": "0.21.5",
    "framer-motion": "10.16.16",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "0.160.0",
    "@react-three/fiber": "8.15.16"
  }
}
